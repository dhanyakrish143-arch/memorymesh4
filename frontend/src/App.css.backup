}

/* ---------- INSIGHT ---------- */

.activity-insight {
  display: flex !important;
  align-items: center !important;
  gap: 18px !important;
  margin-top: 24px !important;
  padding: 24px 28px !important;
  border: 1px solid #d5efc5 !important;
  border-radius: 20px !important;
  background: linear-gradient(135deg, #f7fdea, #ffffff) !important;
}

.activity-insight-icon {
  width: 52px !important;
  height: 52px !important;
  min-width: 52px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border-radius: 16px !important;
  background: #eaf9e0 !important;
  font-size: 24px !important;
}

.activity-insight h2 {
  margin: 5px 0 6px !important;
  color: #172033 !important;
  font-size: 21px !important;
  font-weight: 900 !important;
}

.activity-insight p {
  margin: 0 !important;
  color: #64748b !important;
  font-size: 14px !important;
  line-height: 1.6 !important;
}

/* ---------- RESPONSIVE ---------- */

@media (max-width: 900px) {
  .activity-stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }

  .activity-row {
    grid-template-columns: 100px minmax(140px, 1fr) 70px 70px !important;
    gap: 12px !important;
  }
}

@media (max-width: 650px) {
  .activity-page {
    padding: 35px 18px 70px !important;
  }

  .activity-stats-grid {
    grid-template-columns: 1fr 1fr !important;
  }

  .activity-section {
    padding: 20px !important;
  }

  .activity-row {
