    grid-row: 1 !important;
  }

  .activity-insight {
    align-items: flex-start !important;
  }
}


/* =========================================================
   MEMORYMESH — ACHIEVEMENTS UI
   ========================================================= */

.achievements-section {
  padding: 28px !important;
}

.achievements-grid {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  gap: 18px !important;
}

.achievement-card {
  display: flex !important;
  align-items: center !important;
  gap: 18px !important;
  min-height: 120px !important;
  padding: 22px !important;
  border-radius: 20px !important;
  border: 1px solid #e4e9ef !important;
  background: #ffffff !important;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.055) !important;
  transition: all 0.22s ease !important;
}

.achievement-card:hover {
  transform: translateY(-4px) !important;
  box-shadow: 0 16px 32px rgba(15, 23, 42, 0.10) !important;
}

.achievement-unlocked {
  border-color: #c9ecb5 !important;
  background: linear-gradient(145deg, #ffffff, #f7fff2) !important;
}

.achievement-locked {
  background: #f8fafc !important;
  opacity: 0.72 !important;
}

.achievement-icon {
  width: 62px !important;
  height: 62px !important;
  min-width: 62px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border-radius: 18px !important;
  background: #f1f5f9 !important;
  font-size: 30px !important;
}

.achievement-unlocked .achievement-icon {
  background: #eaf9e0 !important;
  box-shadow: 0 6px 18px rgba(88, 204, 2, 0.12) !important;
}

.achievement-card h3 {
  margin: 0 0 7px !important;
  color: #172033 !important;
  font-size: 17px !important;
  font-weight: 900 !important;
  letter-spacing: -0.02em !important;
}

.achievement-card p {
  margin: 0 !important;
  color: #718096 !important;
  font-size: 13px !important;
  line-height: 1.5 !important;
}

.achievement-status {
  display: inline-block !important;
  margin-top: 9px !important;
  color: #58cc02 !important;
  font-size: 11px !important;
  font-weight: 900 !important;
}

@media (max-width: 800px) {
  .achievements-grid {
    grid-template-columns: 1fr !important;
  }
}

@media (max-width: 480px) {
  .achievements-section {
    padding: 18px !important;
  }

  .achievement-card {
    padding: 18px !important;
  }

  .achievement-icon {
    width: 52px !important;
    height: 52px !important;
    min-width: 52px !important;
    font-size: 25px !important;
  }
}

