import { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import client from "../api/client";
import Flashcard from "../components/Flashcard";

export default function Review() {
  const [cards, setCards] = useState([]);
  const [sessionTotal, setSessionTotal] = useState(0);
  const [completed, setCompleted] = useState(0);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const loadCards = async () => {
    try {
      setLoading(true);
      setError("");

      const { data } = await client.get("/review/due");
      const dueCards = data || [];

      setCards(dueCards);
      setSessionTotal(dueCards.length);
      setCompleted(0);
    } catch (err) {
      console.error("Failed to load review cards:", err);
      setError("Unable to load your review cards.");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadCards();
  }, []);

  const handleDone = () => {
    setCompleted((current) => current + 1);
    setCards((current) => current.slice(1));
  };

  if (loading) {
    return (
      <div className="page review-page">
        <div className="review-loading-card">
          <div className="review-spinner" />
          <h2>Preparing your review</h2>
          <p>Getting your cards ready...</p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="page review-page">
        <div className="review-error">
          <div className="review-error-icon">!</div>

          <p className="eyebrow">REVIEW</p>

          <h1>Something went wrong</h1>

          <p className="subtitle">{error}</p>

          <button
            type="button"
            className="btn btn-primary"
            onClick={loadCards}
          >
            Try again
          </button>
        </div>
      </div>
    );
  }

  if (sessionTotal === 0) {
    return (
      <div className="page review-page">
        <div className="review-complete">
          <div className="review-complete-icon">✓</div>

          <p className="eyebrow">ALL CAUGHT UP</p>

          <h1 className="brand">Great work!</h1>

          <p className="subtitle">
            You don't have any cards due for review right now.
          </p>

          <div className="review-complete-message">
            <span>🎉</span>
            <p>
              Come back later to keep your memory strong.
            </p>
          </div>

          <div className="review-actions">
            <Link to="/progress" className="btn btn-primary">
              View Progress
            </Link>

            <Link to="/" className="review-home-button">
              Back to Home
            </Link>
          </div>
        </div>
      </div>
    );
  }

  if (cards.length === 0) {
    return (
      <div className="page review-page">
        <div className="review-complete">
          <div className="review-complete-icon">✓</div>

          <p className="eyebrow">SESSION COMPLETE</p>

          <h1 className="brand">Nice work!</h1>

          <p className="subtitle">
            You completed your entire review session.
          </p>

          <div className="review-results">
            <div className="review-result">
              <strong>{completed}</strong>
              <span>Completed</span>
            </div>

            <div className="review-result">
              <strong>{sessionTotal}</strong>
              <span>Total cards</span>
            </div>

            <div className="review-result">
              <strong>100%</strong>
              <span>Session</span>
            </div>
          </div>

          <div className="review-complete-message">
            <span>🔥</span>
            <p>
              Consistency is the key to building long-term memory.
            </p>
          </div>

          <div className="review-actions">
            <Link to="/progress" className="btn btn-primary">
              View Progress
            </Link>

            <Link to="/" className="review-home-button">
              Back to Home
            </Link>
          </div>
        </div>
      </div>
    );
  }

  const currentCard = cards[0];
  const remaining = cards.length;
  const progress = Math.round((completed / sessionTotal) * 100);

  return (
    <div className="page review-page">

      <section className="review-session-header">
        <div>
          <p className="eyebrow">DAILY REVIEW</p>
          <h1>Keep learning</h1>
          <p>
            Strengthen what you already know.
          </p>
        </div>

        <div className="review-session-score">
          <strong>{completed}</strong>
          <span>/ {sessionTotal}</span>
        </div>
      </section>

      <section className="review-progress-card">
        <div className="review-progress-top">
          <span>Session progress</span>
          <strong>{progress}%</strong>
        </div>

        <div className="review-progress">
          <div
            className="review-progress-fill"
            style={{
              width: `${progress}%`,
            }}
          />
        </div>

        <div className="review-progress-bottom">
          <span>
            {completed} completed
          </span>

          <span>
            {remaining} remaining
          </span>
        </div>
      </section>

      <div className="review-instruction">
        <span className="review-instruction-icon">💡</span>

        <div>
          <strong>Think before you reveal</strong>
          <p>
            Try to remember the answer before tapping the card.
          </p>
        </div>
      </div>

      <div className="review-priority-badge">
        <span>🎯</span>
        <strong>{currentCard.priorityReason || "Due for review"}</strong>
      </div>

      <div className="review-card-container">
        <Flashcard
          key={currentCard._id}
          card={currentCard}
          onDone={handleDone}
        />
      </div>

      <p className="review-hint">
        Your answers help MemoryMesh decide when you should see this card
        again.
      </p>
    </div>
  );
}

